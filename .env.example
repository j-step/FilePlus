# FilePlus environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Filesystem paths
# Defaults to <app dir>\FilePlusTestSandbox when unset -- uncomment to override.
# FILEPLUS_SANDBOX_PATH=C:\path\to\your\sandbox
# Defaults to <app dir>\fileplus.db when unset -- uncomment to override.
# FILEPLUS_DB_PATH=C:\path\to\your\fileplus.db
FILEPLUS_EVERYTHING_PATH=C:\Everything

# AI — cloud fallback (Anthropic)
# No default cap enforced — leave blank to disable cloud fallback
ANTHROPIC_API_KEY=sk-ant-...

# AI — local (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Safety
# Writes (rename/move/copy/delete) stay inside FILEPLUS_SANDBOX_PATH until this
# is true. System roots are never writable.
WRITE_UNLOCKED=false

# Auto-sort
AUTO_SORT_ENABLED=false
AUTO_SORT_CONFIDENCE_THRESHOLD=0.85
MAX_BATCH_SIZE=100

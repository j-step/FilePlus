# FilePlus environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Environment: dev (default) | test | prod. In dev and test, nothing outside
# the root below can ever be written, moved, renamed or deleted -- whatever
# WRITE_UNLOCKED says. Only prod honours WRITE_UNLOCKED.
# FILEPLUS_ENV=dev

# Filesystem paths
# The one folder FilePlus may write into. FILEPLUS_ROOT and
# FILEPLUS_SANDBOX_PATH are two names for the same setting (set only one).
# Defaults to <app dir>\FilePlusTestSandbox when unset -- uncomment to override.
# FILEPLUS_ROOT=C:\path\to\your\sandbox
# Defaults to <app dir>\fileplus.db when unset -- uncomment to override.
# FILEPLUS_DB_PATH=C:\path\to\your\fileplus.db
FILEPLUS_EVERYTHING_PATH=C:\Everything

# Networking
# Backend HTTP port; defaults to 9876. Override to run a second backend
# alongside one already using 9876 (scripts/verify.ps1 sets this to 9877).
# FILEPLUS_PORT=9876

# Auth
# Every route except /health requires header X-FilePlus-Token. Leave this
# unset and the backend mints a random token at startup and writes it to
# <app dir>\.fileplus-token (git-ignored), which frontend/main.js reads --
# auth is never off. Set it to pin a shared value instead (scripts/verify.ps1
# does, so its Electron smoke and its backend agree).
# FILEPLUS_API_TOKEN=<random hex>

# AI — cloud fallback (Anthropic)
# No default cap enforced — leave blank to disable cloud fallback
ANTHROPIC_API_KEY=sk-ant-...

# AI — local (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Logs: backend.log, main.log and renderer.log. Defaults to <app dir>\logs.
# FILEPLUS_LOG_DIR=C:\path\to\logs

# Safety
# Writes (rename/move/copy/delete) stay inside the root until this is true AND
# FILEPLUS_ENV=prod. System roots are never writable.
WRITE_UNLOCKED=false

# Auto-sort
AUTO_SORT_ENABLED=false
AUTO_SORT_CONFIDENCE_THRESHOLD=0.85
MAX_BATCH_SIZE=100

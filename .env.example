# FilePlus environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Filesystem paths
FILEPLUS_SANDBOX_PATH=c:\Dev\FilePlus\FilePlusTestSandbox
FILEPLUS_DB_PATH=C:\Dev\FilePlus\fileplus.db
FILEPLUS_EVERYTHING_PATH=C:\Everything

# AI — cloud fallback (Anthropic)
# No default cap enforced — leave blank to disable cloud fallback
ANTHROPIC_API_KEY=sk-ant-...

# AI — local (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Safety
# Keep true during development. Set false ONLY for real filesystem operations
# after the scan/classify pipeline has been validated against the sandbox
# at least three times.
SAFETY_MODE=true

# Auto-sort
AUTO_SORT_ENABLED=false
AUTO_SORT_CONFIDENCE_THRESHOLD=0.85
MAX_BATCH_SIZE=100

# Nexus environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Filesystem paths
NEXUS_SANDBOX_PATH=C:\NexusTestSandbox
NEXUS_DB_PATH=C:\Dev\nexus\nexus.db

# AI — cloud fallback (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# AI — local (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Safety
# Keep true during development. Set false ONLY for real filesystem operations
# after the app has been fully validated in the sandbox.
SAFETY_MODE=true

# Auto-sort
AUTO_SORT_ENABLED=false
AUTO_SORT_CONFIDENCE_THRESHOLD=0.85
MAX_BATCH_SIZE=100
